load("@gazelle//:def.bzl", "gazelle", "gazelle_binary", "gazelle_test")

# gazelle: generate and update BUILD.bazel
# Run: bazel run //:gazelle
gazelle(
    name = "gazelle",
    gazelle = ":gazelle_binary",
    mode = "fix",
)

gazelle_binary(
    name = "gazelle_binary",
    languages = [
        "@gazelle//language/go",
    ],
)

gazelle_test(
    name = "gazelle_test",
    size = "small",
    gazelle = ":gazelle_binary",
    workspace = "//:BUILD.bazel",
)

# gazelle:prefix github.com/yureutaejin/template-monozel
